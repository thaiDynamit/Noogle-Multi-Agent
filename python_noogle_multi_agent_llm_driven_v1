class DataCalculationWorker(WorkerAgent): 
    def get_description_for_llm(self) -> dict: return {"name":"calculator", "description":"Calculates average Rotten Tomatoes score (proxy) from a list of movies.", "parameters":{"type":"object", "properties":{"calculation_type":{"type":"string", "enum":["average_rt_score"]}, "movies_data":{"type":"array", "description":"List of movie objects with 'rotten_tomatoes_proxy'.", "items":{"type":"object", "properties":{"rotten_tomatoes_proxy":{"type":"number"}}}}}, "required":["calculation_type", "movies_data"]}}
    def execute(self, task_details: dict, previous_results: dict = None, conversation_history: list = None) -> dict:
        print(f"--- [{self.get_name()}] Executing: {task_details} ---")
        movies_data = task_details.get("movies_data", [])
        if not movies_data: return {"average_score": None, "count": 0, "error": "No movie data."}
        scores = [m.get("rotten_tomatoes_proxy") for m in movies_data if m.get("rotten_tomatoes_proxy") is not None]
        if not scores: return {"average_score": None, "count": 0, "message": "No valid scores."}
        return {"average_score": round(statistics.mean(scores), 1), "count": len(scores)}

class SummarizationWorker(WorkerAgent): 
    def get_description_for_llm(self) -> dict: return {"name":"summarizer", "description":"Summarizes text or movie overviews.", "parameters":{"type":"object", "properties":{"text_to_summarize":{"type":"string"}, "movies_data":{"type":"array", "items":{"type":"object", "properties":{"overview":{"type":"string"}}}}}}}
    def execute(self, task_details: dict, previous_results: dict = None, conversation_history: list = None) -> dict:
        print(f"--- [{self.get_name()}] Executing: {task_details} ---")
        text_to_summarize = task_details.get("text_to_summarize", ""); movies_data = task_details.get("movies_data", [])
        if movies_data:
            overviews = [m.get("overview","").strip() for m in movies_data if m.get("overview","").strip()]
            if overviews: text_to_summarize = " ".join(overviews)
            else: return {"summary": "", "message": "No overviews to summarize."}
        if not text_to_summarize.strip(): return {"summary": "", "error": "No text for summarization."}
        return {"summary": textwrap.shorten(text_to_summarize, width=250, placeholder="...")}

