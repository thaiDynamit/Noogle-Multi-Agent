# --- Base Worker Agent ---
class WorkerAgent:
    def get_name(self):
        return self.__class__.__name__

    def get_description_for_llm(self) -> dict:
        raise NotImplementedError("Worker agents must implement 'get_description_for_llm'.")

    def execute(self, task_details: dict, previous_results: dict = None, conversation_history: list = None) -> dict:
        raise NotImplementedError("Worker agents must implement the 'execute' method.")

# --- Worker Agent Implementations ---
class MovieDataWorker(WorkerAgent): # Now using OMDb
    def get_description_for_llm(self) -> dict:
        return {
            "name": "movie_data_fetcher",
            "description": "Fetches movie information from OMDb. Best used for looking up specific movie titles. Can also perform a general search for a term which might return multiple movies (less detailed). Provides details like year, plot, actors, box office (usually US domestic), and ratings including Rotten Tomatoes if available.",
            "parameters": {
                "type": "object",
                "properties": {
                    "movie_title_query": {"type": "string", "description": "The specific title of the movie to search for (e.g., 'The Matrix'). This is the preferred method for detailed info."},
                    "general_search_term": {"type": "string", "description": "A general term to search for (e.g., 'Keanu Reeves' or 'Matrix'). This returns a list of matching titles, usually less detailed than a specific title query."},
                    "year_after_filter": {"type": "integer", "description": "(Optional) If filtering a list of movies from a general search, only include movies released after this year.", "nullable": True},
                    "min_gross_filter": {"type": "integer", "description": "(Optional) If filtering a list of movies, only include movies with BoxOffice (US) greater than this amount.", "nullable": True}
                }
            }
        }

    def _parse_omdb_movie_data(self, omdb_data: dict) -> dict | None:
        if not omdb_data or omdb_data.get("Response") == "False":
            return None

        box_office_str = omdb_data.get("BoxOffice", "N/A").replace("$", "").replace(",", "")
        worldwide_gross_usd = None
        try:
            worldwide_gross_usd = int(box_office_str)
        except ValueError:
            worldwide_gross_usd = 0 

        rt_score = None
        ratings = omdb_data.get("Ratings", [])
        for rating_source in ratings:
            if rating_source.get("Source") == "Rotten Tomatoes":
                try:
                    rt_score = int(rating_source.get("Value", "").replace("%", ""))
                except ValueError:
                    rt_score = None
                break
        
        year = None
        try:
            year_str = omdb_data.get("Year","0000")
            year_match = re.match(r"(\d{4})", year_str) 
            if year_match:
                year = int(year_match.group(1))
        except: pass


        return {
            "title": omdb_data.get("Title"),
            "year": year,
            "worldwide_gross_usd": worldwide_gross_usd, 
            "rotten_tomatoes_proxy": rt_score,
            "imdb_id": omdb_data.get("imdbID"),
            "plot": omdb_data.get("Plot"),
            "actors": omdb_data.get("Actors"),
            "director": omdb_data.get("Director")
        }

    def execute(self, task_details: dict, previous_results: dict = None, conversation_history: list = None) -> dict:
        movie_title_query = task_details.get("movie_title_query")
        general_search_term = task_details.get("general_search_term")
        year_after_filter = task_details.get("year_after_filter")
        min_gross_filter = task_details.get("min_gross_filter")

        print(f"--- [{self.get_name()} with OMDb] Executing with details: {task_details} ---")
        if OMDB_API_KEY == 'YOUR_OMDB_API_KEY': 
            print(f"--- [{self.get_name()}] CRITICAL ERROR: OMDB_API_KEY is still the placeholder 'YOUR_OMDB_API_KEY'. ---")
            return {"error": "OMDB API Key is placeholder. Please replace it."}


        params = {"apikey": OMDB_API_KEY}
        movies_data_list = []

        try:
            if movie_title_query:
                params["t"] = movie_title_query
                params["plot"] = "full" 
                response = requests.get(OMDB_BASE_URL, params=params)
                response.raise_for_status()
                data = response.json()
                parsed_movie = self._parse_omdb_movie_data(data)
                if parsed_movie:
                    movies_data_list.append(parsed_movie)
                elif data.get("Error"):
                     return {"movies": [], "message": f"OMDb: {data.get('Error')} for title '{movie_title_query}'."}

            elif general_search_term:
                params["s"] = general_search_term
                response = requests.get(OMDB_BASE_URL, params=params)
                response.raise_for_status()
                data = response.json()
                if data.get("Response") == "True" and "Search" in data:
                    search_results = data["Search"]
                    print(f"--- [{self.get_name()}] General search for '{general_search_term}' found {len(search_results)} potential titles. Fetching details... ---")
                    for movie_stub in search_results[:5]: 
                        if movie_stub.get("imdbID"):
                            detail_params = {"apikey": OMDB_API_KEY, "i": movie_stub["imdbID"], "plot": "full"}
                            detail_response = requests.get(OMDB_BASE_URL, params=detail_params)
                            if detail_response.status_code == 200:
                                detail_data = detail_response.json()
                                parsed_movie = self._parse_omdb_movie_data(detail_data)
                                if parsed_movie:
                                    movies_data_list.append(parsed_movie)
                            else:
                                print(f"--- [{self.get_name()}] Error fetching details for IMDb ID {movie_stub['imdbID']}: Status {detail_response.status_code} ---")
                elif data.get("Error"):
                    return {"movies": [], "message": f"OMDb: {data.get('Error')} for search term '{general_search_term}'."}
            else:
                return {"error": "MovieDataWorker: Movie title or general search term is required for OMDb."}

            final_filtered_movies = []
            if movies_data_list:
                for movie in movies_data_list:
                    passes_filter = True
                    if year_after_filter is not None and movie.get("year") is not None:
                        if movie["year"] <= year_after_filter:
                            passes_filter = False
                    if min_gross_filter is not None and movie.get("worldwide_gross_usd") is not None: 
                        if movie["worldwide_gross_usd"] <= min_gross_filter:
                            passes_filter = False
                    if passes_filter:
                        final_filtered_movies.append(movie)
            
            if not final_filtered_movies and (movie_title_query or general_search_term) and movies_data_list: 
                return {"movies": [], "message": "Found movies but none matched all filter criteria (year/gross)."}

            return {"movies": final_filtered_movies}

        except requests.exceptions.RequestException as e:
            return {"error": f"OMDb API request error: {e}"} # This is the error you are seeing
        except ValueError as e: 
            return {"error": f"Error decoding OMDb API JSON response: {e}"}
        except Exception as e:
            return {"error": f"Unexpected error in MovieDataWorker: {e}"}

